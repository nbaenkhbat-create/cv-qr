rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: employers/{uid}
//   Required: uid, email, username, companyName, createdAt
//   Optional: phone
//
// Collection: usernames/{username}
//   Required: uid, email, username, createdAt
//
// Collection: jobs/{jobId}
//   Required: employerId, title, description, questions, active,
//             createdAt, updatedAt
//
// Collection: applications/{appId}
//   Required: jobId, employerId, jobTitle, name, phone, email,
//             answers, status, createdAt, updatedAt
//   Optional: employerNote
//
// Time fields accept number (Date.now()) OR timestamp (serverTimestamp()).
// keys().hasAll() = required keys must exist; extra optional keys OK.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Accept Date.now() (number) or serverTimestamp() (timestamp)
    function isTime(value) {
      return value is number || value is timestamp;
    }

    function isNonEmptyString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() < maxLen;
    }

    function isValidEmployer() {
      let d = request.resource.data;
      return d.keys().hasAll(['uid', 'email', 'username', 'companyName', 'createdAt'])
        && d.uid == request.auth.uid
        && d.email is string
        && d.username is string
        && d.username.size() >= 3
        && d.username.size() <= 30
        && isNonEmptyString(d.companyName, 120)
        && isTime(d.createdAt)
        && (!('phone' in d) || d.phone is string);
    }

    function isValidJobCreate() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'employerId', 'title', 'description', 'questions',
          'active', 'createdAt', 'updatedAt'
        ])
        && d.employerId == request.auth.uid
        && isNonEmptyString(d.title, 120)
        && d.description is string
        && d.questions is list
        && d.active is bool
        && isTime(d.createdAt)
        && isTime(d.updatedAt);
    }

    function isValidJobUpdate() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'employerId', 'title', 'description', 'questions',
          'active', 'createdAt', 'updatedAt'
        ])
        && d.employerId == resource.data.employerId
        && d.employerId == request.auth.uid
        && isNonEmptyString(d.title, 120)
        && d.description is string
        && d.questions is list
        && d.active is bool
        && isTime(d.createdAt)
        && isTime(d.updatedAt);
    }

    function isValidApplicationCreate() {
      let d = request.resource.data;
      return d.keys().hasAll([
          'jobId', 'employerId', 'jobTitle', 'name', 'phone', 'email',
          'answers', 'status', 'createdAt', 'updatedAt'
        ])
        && d.jobId is string
        && d.employerId is string
        && d.jobTitle is string
        && isNonEmptyString(d.name, 120)
        && isNonEmptyString(d.phone, 40)
        && d.email is string
        && d.email.size() > 3
        && d.answers is map
        && d.status == 'new'
        && isTime(d.createdAt)
        && isTime(d.updatedAt)
        && (!('employerNote' in d) || d.employerNote is string);
    }

    function isValidApplicationUpdate() {
      let d = request.resource.data;
      let old = resource.data;
      return d.keys().hasAll([
          'jobId', 'employerId', 'jobTitle', 'name', 'phone', 'email',
          'answers', 'status', 'createdAt', 'updatedAt'
        ])
        && d.employerId == old.employerId
        && d.jobId == old.jobId
        && d.email == old.email
        && d.phone == old.phone
        && d.name == old.name
        && d.answers == old.answers
        && d.status in ['new', 'viewed', 'approved', 'rejected', 'contacted']
        && isTime(d.createdAt)
        && isTime(d.updatedAt)
        && (!('employerNote' in d) || d.employerNote is string)
        && (!('photoUrl' in d) || d.photoUrl is string)
        && (!('publicVisibility' in d) || d.publicVisibility is map);
    }

    match /employers/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidEmployer();
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && isValidEmployer();
      allow delete: if false;
    }

    // Public get for login username → email lookup
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['uid', 'email', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.email is string
        && isTime(request.resource.data.createdAt);
      allow update, delete: if false;
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidJobCreate();
      allow update: if isAuthenticated()
        && resource.data.employerId == request.auth.uid
        && isValidJobUpdate();
      allow delete: if isAuthenticated()
        && resource.data.employerId == request.auth.uid;
    }

    match /applications/{appId} {
      allow read: if true;
      allow create: if isValidApplicationCreate();
      allow update: if isAuthenticated()
        && resource.data.employerId == request.auth.uid
        && isValidApplicationUpdate();
      allow delete: if isAuthenticated()
        && resource.data.employerId == request.auth.uid;
    }
  }
}
